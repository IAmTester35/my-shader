value.CLOUD_LAYERS.1=Mây Tích (Cumulus)
value.CLOUD_LAYERS.2=Mây Tích + Mây Ti (Cirrus)
option.CLOUD_WMO_GENUS=Chủng Loại Mây (WMO Atlas)
option.CLOUD_WMO_GENUS.comment=Chọn 1 trong 10 chủng loại mây chuẩn khí tượng quốc tế WMO. Mức 0: Tự động biến đổi theo thời tiết và vùng sinh thái (Biome).
value.CLOUD_WMO_GENUS.0=Tự Động (Thời Tiết & Biome)
value.CLOUD_WMO_GENUS.1=Mây Ti (Cirrus - Ci)
value.CLOUD_WMO_GENUS.2=Mây Ti Tích (Cirrocumulus - Cc)
value.CLOUD_WMO_GENUS.3=Mây Ti Tầng (Cirrostratus - Cs)
value.CLOUD_WMO_GENUS.4=Mây Trung Tích (Altocumulus - Ac)
value.CLOUD_WMO_GENUS.5=Mây Trung Tầng (Altostratus - As)
value.CLOUD_WMO_GENUS.6=Mây Tầng Tích (Stratocumulus - Sc)
value.CLOUD_WMO_GENUS.7=Mây Tầng (Stratus - St)
value.CLOUD_WMO_GENUS.8=Mây Vũ Tầng (Nimbostratus - Ns)
value.CLOUD_WMO_GENUS.9=Mây Tích (Cumulus - Cu)
value.CLOUD_WMO_GENUS.10=Mây Vũ Tích (Cumulonimbus - Cb)
option.CLOUD_COVERAGE=Độ Che Phủ Của Mây
option.CLOUD_COVERAGE.comment=Hệ số nhân độ che phủ bầu trời của các khối mây.
option.CLOUD_SPEED=Tốc Độ Gió
option.CLOUD_DENSITY=Độ Dày Của Mây
option.CLOUD_SILVER_LINING=Viền Sáng Bạc Tán Xạ Kép
option.CLOUD_SHADOWING=Tự Đổ Bóng Khối & Hiệu Ứng Đường Bột
option.CLOUD_ICE_HALO=Quầng Băng 22° Mây Ti Tầng
option.CLOUD_ICE_HALO.comment=Vòng khúc xạ hào quang 22° quanh Mặt trời và Mặt trăng do tinh thể băng lục giác trong mây ti tầng gây ra.

# Thời tiết
option.DYNAMIC_WEATHER=Thời Tiết Động
option.RAIN_FOG_DENSITY=Mật Độ Sương Mưa
option.STORM_LIGHTNING=Hệ Thống Sét Điện Ảnh (CG/CC/IC)
option.LIGHTNING_BOLTS=Tia Sét Fractal Rõ Nét (Đất & Mây)
option.LIGHTNING_BRANCH_GEN=Cấp Độ Phân Nhánh (Branch Gen)
option.LIGHTNING_BRANCH_GEN.comment=Độ sâu fractal của cây phân nhánh: 1=Chỉ thân chính, 2=Nhánh sơ cấp, 3=Nhánh thứ cấp, 4=Đầy đủ 4 thế hệ phân nhánh tự nhiên.
option.LIGHTNING_ROUGHNESS=Độ Gập Góc / Gồ Ghề (Tortuosity)
option.LIGHTNING_ROUGHNESS.comment=Hệ số gập góc và dao động đánh thủng điện môi (Stepped Leader Jitter). Mức 1.6 mang lại độ chân thực vật lý cao nhất.
option.LIGHTNING_INTRA_CLOUD=Sét Sáng Thể Tích Trong Lòng Mây
option.LIGHTNING_INTENSITY=Cường Độ Sáng Của Sét
option.RAIN_STREAKS=Chi Tiết Vệt Hạt Mưa
option.PROCEDURAL_RAIN=Hạt Mưa Kim Khí Động Học
option.PROCEDURAL_RAIN.comment=Thay thế vệt mưa sprite thô của Vanilla bằng các hạt kim nước siêu mịn với profin Gaussian và vuốt nhọn khí động học.
option.RAIN_MIE_GLISTEN=Hạt Mưa Bắt Sáng Tán Xạ Mie
option.RAIN_MIE_GLISTEN.comment=Hạt mưa lấp lánh như kim cương khi hướng góc nhìn ngược sáng về phía mặt trời hoặc mặt trăng.
option.PROCEDURAL_SNOW=Bông Tuyết Tinh Thể Lục Giác
option.PROCEDURAL_SNOW.comment=Khởi tạo thủ tục bông tuyết 6 cánh Keplerian (đối xứng D6h) với các nhánh xương cá tinh thể băng tự nhiên.
option.SNOW_FLUTTER=Tuyết Chao Đảo Khí Động Học
option.SNOW_FLUTTER.comment=Mô phỏng chuyển động xoay tròn và chao đảo vi mô của bông tuyết khi rơi trong không khí.
option.SNOW_DIAMOND_DUST=Lấp Lánh Bụi Kim Cương
option.SNOW_DIAMOND_DUST.comment=Các mặt tinh thể băng phản xạ lóe sáng lấp lánh dưới ánh mặt trời, trăng sao và ánh đuốc.
option.SNOW_CRYSTAL_SIZE=Kích Thước Bông Tuyết
option.SNOW_CRYSTAL_SIZE.comment=Tỉ lệ kích thước tinh thể của bông tuyết thủ tục.
option.WETNESS_EFFECT=Mặt Đất Ướt Nước

# Lửa & Plasma Nhiệt Động Học
screen.FIRE_SCREEN=Lửa & Plasma
screen.FIRE_SCREEN.comment=Nhiệt động học vật đen, đối lưu chất lưu, plasma lửa linh hồn và viền lửa màn hình.
option.CINEMATIC_FIRE=Lửa Nhiệt Động Học Điện Ảnh
option.CINEMATIC_FIRE.comment=Thay thế texture lửa 16 frame của Vanilla bằng phổ bức xạ vật đen Planck và đối lưu chất lưu liên tục.
option.FIRE_BLACKBODY_CORE=Lõi Cháy Phát Xạ Rực Sáng
option.FIRE_BLACKBODY_CORE.comment=Mô phỏng bức xạ vật đen nhiệt độ cao (>2000K) với lõi trắng vàng HDR hòa quyện mượt mà qua ACES tonemapping.
option.FIRE_TURBULENCE=Lưỡi Lửa Cuộn Đối Lưu
option.FIRE_TURBULENCE.comment=Sử dụng nhiễu gradient đa tầng mô phỏng luồng khí nóng nâng các lưỡi lửa uốn lượn tự nhiên.
option.SOUL_FIRE_SPECTRAL=Lửa Linh Hồn Plasma Dải Swan
option.SOUL_FIRE_SPECTRAL.comment=Bức xạ plasma ion hóa năng lượng cao dải Swan (gốc CH/C2 tự do) màu xanh ngọc huyền bí cho lửa linh hồn.
option.FIRE_EMBERS=Tàn Lửa & Đốm Sáng Bay Lên
option.FIRE_EMBERS.comment=Các đốm tàn lửa phát quang siêu nhỏ tách khỏi ngọn lửa và bay lên theo luồng khí nóng.
option.CINEMATIC_SCREEN_FIRE=Viền Lửa Màn Hình Điện Ảnh
option.CINEMATIC_SCREEN_FIRE.comment=Thay thế bức tường lửa che kín mặt của Vanilla bằng viền lửa liếm nhẹ ở mép màn hình, giữ tầm nhìn trung tâm hoàn toàn thông suốt.
option.SCREEN_FIRE_OPACITY=Độ Đậm Viền Lửa Màn Hình
option.SCREEN_FIRE_OPACITY.comment=Cường độ sáng và độ trong suốt của viền lửa khi người chơi bị bốc cháy.

# Hậu kỳ & Màu sắc
option.TONEMAP_ACES=Chỉnh Màu Điện Ảnh ACES
option.EXPOSURE=Độ Phơi Sáng
option.SATURATION=Độ Bão Hòa Màu
option.VIGNETTE=Làm Tối Góc Màn Hình (Vignette)
option.VIGNETTE_STRENGTH=Cường Độ Tối Góc
