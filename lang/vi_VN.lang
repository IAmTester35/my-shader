# Khí hậu Biome
option.BIOME_ADAPTATION=Hệ Thống Khí Hậu Theo Biome
option.DESERT_SANDSTORM=Bão Cát Sa Mạc (Thay Mưa)

# Bầu trời & Khí quyển
option.ATMOSPHERE_DENSITY=Mật Độ Khí Quyển
value.ATMOSPHERE_DENSITY.0.5=Rất Mỏng
value.ATMOSPHERE_DENSITY.0.75=Mỏng
value.ATMOSPHERE_DENSITY.1.0=Tiêu Chuẩn
value.ATMOSPHERE_DENSITY.1.25=Dày
value.ATMOSPHERE_DENSITY.1.5=Rất Dày
value.ATMOSPHERE_DENSITY.2.0=Cực Dày
option.RAYLEIGH_SCALE=Hệ Số Tán Xạ Rayleigh
option.RAYLEIGH_SCALE.comment=Điều biến độ dày quang học tán xạ Rayleigh phân tử không khí. Tạo nên sắc xanh lam ngọc đặc trưng của đỉnh vòm trời.
option.MIE_TURBIDITY=Độ Đục Khí Dung (Mie Turbidity)
option.MIE_TURBIDITY.comment=Kiểm soát nồng độ hạt bụi và hơi ẩm khí quyển. Giá trị cao tạo vầng hào quang mặt trời ấm áp và đường chân trời mờ ảo.
option.OZONE_SCALE=Nồng Độ Khí Ozone
option.OZONE_SCALE.comment=Hệ số hấp thụ dải Chappuis của tầng ozone bình lưu. Tạo nên sắc tím chàm Giờ Xanh (Blue Hour) lúc chạng vạng.
option.MULTI_SCATTER_SCALE=Tán Xạ Đa Tầng (Multi-Scattering)
option.MULTI_SCATTER_SCALE.comment=Cường độ ánh sáng khuếch tán đa cấp trong khí quyển, làm dịu bóng tối và hòa quyện màu sắc tự nhiên.
option.SUN_ILLUMINANCE=Độ Rọi Quang Học Mặt Trời
option.SUN_ILLUMINANCE.comment=Bức xạ quang thông mặt trời trực tiếp chiếu từ đỉnh khí quyển.
option.SKY_RADIANCE_SCALE=Độ Phơi Sáng Bầu Trời
option.SKY_RADIANCE_SCALE.comment=Hệ số điều chỉnh độ sáng vòm trời thiên cầu.
option.RAYLEIGH_SCATTERING=Tán Xạ Rayleigh
option.MIE_SCATTERING=Tán Xạ Hạt Mie
option.OZONE_ABSORPTION=Hấp Thụ Ozone Chappuis (Giờ Xanh)
option.BELT_OF_VENUS=Vành Đai Sao Kim & Bóng Trái Đất
option.BELT_OF_VENUS.comment=Tái hiện dải hoàng hôn hồng cam và bóng xám lam của Trái Đất ở chân trời đối diện mặt trời lúc chạng vạng.
option.SKY_MULTI_SCATTERING=Tán Xạ Khí Quyển Bậc Cao (Fill)
option.SKY_MULTI_SCATTERING.comment=Mô phỏng tán xạ thứ cấp lấp đầy vùng tối bầu trời, giúp chuyển tiếp màu mượt mà tự nhiên.
option.SKY_GROUND_FOG=Sương Mù Chân Trời

# Mặt trời
option.ENABLE_SUN=Mặt Trời Thủ Tục Chân Thực
option.SUN_SIZE=Kích Thước Mặt Trời
option.SUN_LIMB_DARKENING=Hiệu Ứng Tối Viền (Limb)
option.SUN_ATMOSPHERIC_FLATTENING=Biến Dạng Khí Quyển Chân Trời
option.SUN_ATMOSPHERIC_FLATTENING.comment=Khúc xạ khí quyển nén dẹp mặt trời theo trục đứng khi lặn sát đường chân trời.
option.SUN_CHROMATIC_CORONA=Nhật Hoa Tán Sắc Plasma
option.SUN_CHROMATIC_CORONA.comment=Quầng tán sắc viền plasma đa bước sóng quanh vành nhật hoa mặt trời.
option.SUN_CORONA_INTENSITY=Vành Nhật Hoa (Corona)
option.SUN_GLARE=Chói Sáng Khí Quyển
option.SOLAR_DIFFRACTION_SPIKES=Tia Khúc Xạ Ống Kính (Diffraction Spikes)
option.GODRAYS=Tia Sáng Mặt Trời (God Rays)
option.GODRAYS_INTENSITY=Cường Độ Tia Sáng
option.GODRAYS_SAMPLES=Số Mẫu Tia Sáng (Samples)
value.GODRAYS_SAMPLES.16=16 Mẫu (Nhanh)
value.GODRAYS_SAMPLES.20=20 Mẫu (Mịn)
value.GODRAYS_SAMPLES.24=24 Mẫu (Chất Lượng Cao)
value.GODRAYS_SAMPLES.32=32 Mẫu (Ultra)
value.GODRAYS_SAMPLES.40=40 Mẫu (Điện Ảnh)

# Mặt trăng & Bầu trời đêm
option.ENABLE_MOON=Mặt Trăng Thủ Tục Chi Tiết Cao
option.MOON_SIZE=Kích Thước Mặt Trăng
option.MOON_BRIGHTNESS=Độ Sáng Mặt Trăng
option.MOON_BRIGHTNESS.comment=Điều chỉnh độ rực rỡ và cường độ phát xạ trực tiếp của bề mặt mặt trăng.
option.MOON_PHASES=Tuần Trăng Chính Xác (8 Pha)
option.MOON_SURFACE_DETAIL=Chi Tiết Miệng Núi & Biển Basalt
option.MOON_CRATER_RELIEF=Đổ Bóng Miệng Núi Lửa 3D
option.MOON_CRATER_RELIEF.comment=Mô phỏng gồ ghề 3D của các vành hố va chạm dọc theo đường phân ranh sáng tối.
option.MOON_EARTHSHINE=Ánh Đất Chiếu Trăng (Earthshine)
option.MOON_HALO=Quầng Sáng Mặt Trăng & Vòng Băng
option.MOON_HALO_INTENSITY=Cường Độ Quầng Sáng
option.ENABLE_STARS=Sao Đêm
option.STARS_DENSITY=Mật Độ Sao
option.STARS_TWINKLE=Sao Nhấp Nháy Khí Quyển
option.STARS_COLOR_VARIETY=Màu Sao Phổ Nhiệt (Ballesteros B-V)
option.NASA_SVS_MILKY_WAY=Ngân Hà NASA SVS 4851 (1,7 Tỷ Sao)
option.NASA_SVS_MILKY_WAY.comment=Tái hiện dải Ngân Hà thực tế từ dữ liệu Gaia DR2 và Tycho-2 của NASA SVS 4851.
option.MILKY_WAY=Bật Dải Ngân Hà
option.MILKY_WAY_BRIGHTNESS=Độ Sáng Ngân Hà
option.MILKY_WAY_H_ALPHA=Tinh Vân Hydro-Alpha Ngân Hà
option.MILKY_WAY_H_ALPHA.comment=Tăng cường các dải tinh vân phát xạ màu đỏ/hồng sẫm Hydro-alpha trong dải Ngân Hà.
option.CONSTELLATION_FIGURES=Đường Nối Chòm Sao (IAU Figures)
option.CONSTELLATION_FIGURES.comment=Hiển thị đường nối sao của 88 chòm sao thiên văn theo chuẩn IAU từ NASA SVS 4851.
option.CONSTELLATION_INTENSITY=Độ Sáng Đường Chòm Sao
option.CELESTIAL_GRID=Lưới Tọa Độ Thiên Văn (RA/Dec)
option.CELESTIAL_GRID.comment=Hiển thị lưới xích đạo thiên cầu (Xích kinh & Xích vĩ J2000) từ NASA SVS 4851.
option.CELESTIAL_GRID_INTENSITY=Độ Sáng Lưới Tọa Độ
option.CELESTIAL_LATITUDE=Vĩ Độ Thiên Cầu Quan Sát
option.CELESTIAL_LATITUDE.comment=Góc nâng thiên cực Bắc (sao Bắc Đẩu/Polaris) theo vĩ độ địa lý người quan sát.
value.CELESTIAL_LATITUDE.0.0=0° (Xích Đạo)
value.CELESTIAL_LATITUDE.20.0=20° Bắc (Nhiệt Đới)
value.CELESTIAL_LATITUDE.30.0=30° Bắc
value.CELESTIAL_LATITUDE.42.0=42° Bắc (Ôn Đới - Mặc định)
value.CELESTIAL_LATITUDE.50.0=50° Bắc
value.CELESTIAL_LATITUDE.60.0=60° Bắc (Cận Cực)
value.CELESTIAL_LATITUDE.90.0=90° Bắc (Bắc Cực)
option.METEOR_SHOWERS=Mưa Sao Băng (Meteors)
option.AURORA_BOREALIS=Cực Quang Đa Tầng (Aurora Borealis)
option.AURORA_INTENSITY=Cường Độ Cực Quang
option.AURORA_RAY_STREAMERS=Cột Sáng Cực Quang Động
option.AURORA_RAY_STREAMERS.comment=Mô phỏng các tia sáng từ trường chuyển động nhanh dọc theo dải lụa cực quang.

# Mây thể tích 3D
option.ENABLE_CLOUDS=Bật Hệ Thống Mây
option.VOLUMETRIC_3D_CLOUDS=Mây Thể Tích 3D (Raymarched)
option.VOLUMETRIC_CLOUD_STEPS=Số Bước Raymarch Mây
value.VOLUMETRIC_CLOUD_STEPS.12=Nhanh (12 Bước)
value.VOLUMETRIC_CLOUD_STEPS.16=Vừa (16 Bước)
value.VOLUMETRIC_CLOUD_STEPS.20=Cao (20 Bước)
value.VOLUMETRIC_CLOUD_STEPS.24=Siêu Cao (24 Bước)
value.VOLUMETRIC_CLOUD_STEPS.28=Rất Cao (28 Bước)
